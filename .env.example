# Server configuration
SERVER_PORT=8080

# Database (MySQL) configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=employee_db
DB_USERNAME=root
DB_PASSWORD=root

# Demo Data Seeding (seeds initial sample employees and admin account if empty)
APP_SEED_ENABLED=true

# CORS configuration (comma-separated origins)
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# JWT Security
# Secret key must be at least 32 characters (256-bit)
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1mb3Itand0LWF1dGhlbnRpY2F0aW9uLXRlc3RpbmctMTIzNDU2
JWT_EXPIRATION_MINUTES=480

# Initial Admin Account (seeded on first boot when user table is empty)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
